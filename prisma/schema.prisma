// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ============================================================
// 00 · SESSION  (Shopify OAuth — existing model)
// ============================================================

model tbl_Session {
  session_id          String    @id @default(auto()) @map("_id") @db.ObjectId
  id                  String    @unique
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ============================================================
// 01 · DESIGN  (Core hub entity — every customization lives here)
// ============================================================

model tbl_Design {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Shopify references
  shop                   String
  shopifyCustomerId      String
  shopifyProductId       String
  shopifyVariantId       String?
  shopifyOrderId         String?
  shopifyOrderLineItemId String?

  // Identity
  title  String?
  // Values: DRAFT | SAVED | SUBMITTED | APPROVED | IN_PRODUCTION | COMPLETED | ARCHIVED
  status String  @default("DRAFT")

  // Feature 1 — Save & Share
  shareToken          String    @unique
  shareTokenExpiresAt DateTime?

  // Pointer to the active revision
  currentRevisionId String? @db.ObjectId

  // Feature 9 — Design Library
  isLibraryItem      Boolean   @default(false)
  retentionExpiresAt DateTime?

  // Canvas state (lightweight top-level snapshot; full history in DesignRevision)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  revisions          tbl_DesignRevision[]
  sessions           tbl_DesignSession[]
  libraryItems       tbl_DesignLibraryItem[]
  artworkChecks      tbl_ArtworkCheck[]
  feasibilityChecks  tbl_FeasibilityCheck[]
  proofs             tbl_Proof[]
  comments           tbl_DesignComment[]
  orderTimeline      tbl_OrderTimeline?
  productionFiles    tbl_ProductionFile[]
  productionHandoffs tbl_ProductionHandoff[]
}

// ============================================================
// 02 · DESIGN REVISION  (Feature 8 — Full version history)
// ============================================================

model tbl_DesignRevision {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  designId String     @db.ObjectId
  design   tbl_Design @relation(fields: [designId], references: [id])

  versionNumber Int
  label         String?
  canvasState   Json
  thumbnailUrl  String?
  // Values: CUSTOMER | MERCHANT
  changedBy        String
  changeNote       String?
  isApproved       Boolean @default(false)
  // Values: DRAFT | PENDING_REVIEW | CHANGES_REQUESTED | APPROVED | REJECTED | SUPERSEDED
  status           String  @default("DRAFT")
  assetFingerprint String?
  approvalMeta     Json?

  createdAt DateTime @default(now())

  // Relations
  proofs            tbl_Proof[]
  comments          tbl_DesignComment[]
  artworkChecks     tbl_ArtworkCheck[]
  feasibilityChecks tbl_FeasibilityCheck[]
  productionFiles   tbl_ProductionFile[]
  proofApprovals    tbl_ProofApproval[]
  libraryItems      tbl_DesignLibraryItem[]
}

// ============================================================
// 03 · DESIGN SESSION  (Feature 1 — Cross-session persistence)
// ============================================================

model tbl_DesignSession {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  designId String     @db.ObjectId
  design   tbl_Design @relation(fields: [designId], references: [id])

  sessionToken      String    @unique
  shopifyCustomerId String?
  lastActiveAt      DateTime  @default(now())
  deviceInfo        Json?
  expiresAt         DateTime?

  createdAt DateTime @default(now())
}

// ============================================================
// 04 · DESIGN LIBRARY ITEM  (Feature 9 — Reusable design library)
// ============================================================

model tbl_DesignLibraryItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop              String
  shopifyCustomerId String

  designId String     @db.ObjectId
  design   tbl_Design @relation(fields: [designId], references: [id])

  revisionId String             @db.ObjectId
  revision   tbl_DesignRevision @relation(fields: [revisionId], references: [id])

  name         String
  thumbnailUrl String?
  tags         String[]
  isPublic     Boolean  @default(false)

  // Values: KEEP_FOREVER | EXPIRES_AT | ORDER_BASED
  retentionPolicy    String    @default("KEEP_FOREVER")
  retentionExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 05 · ARTWORK CHECK  (Feature 4 — Upload quality validation)
// ============================================================

model tbl_ArtworkCheck {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop             String?
  shopifyProductId String?
  shopifyVariantId String?
  printAreaName    String?             @default("default")

  // Optional design relation: when check is performed on a pre-existing design
  designId String?     @db.ObjectId
  design   tbl_Design? @relation(fields: [designId], references: [id])

  revisionId String?             @db.ObjectId
  revision   tbl_DesignRevision? @relation(fields: [revisionId], references: [id])

  assetUrl String?
  fileName String?
  fileSizeBytes Int?
  mimeType      String?

  // Values: PENDING | PASSED | WARNED | FAILED
  status String @default("PENDING")
  overallQualityScore Float?

  // Detected properties
  resolutionDpi Float?
  effectiveDpi  Float?
  widthPx       Int?
  heightPx      Int?
  aspectRatio   Float?
  blurScore     Float?
  isBlurry      Boolean?
  colorMode     String?
  fileFormat    String?

  // Issues and actionable fixes found
  issues         Json[]
  warnings       Json[]
  suggestedFixes Json[]

  // Required specs (pulled from ProductCustomizationConfig at check time)
  requiredDpi          Float?
  requiredMinDpi       Float?
  requiredWidthPx      Int?
  requiredHeightPx     Int?
  targetAspectRatio    Float?
  aspectRatioTolerance Float?

  checkedAt DateTime @default(now())
}

// ============================================================
// 06 · FEASIBILITY CHECK  (Feature 5 — Production impossibility guard)
// ============================================================

model tbl_FeasibilityCheck {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop             String?
  shopifyProductId String
  shopifyVariantId String?

  // Optional design relation: when check is performed on a pre-existing design session
  designId String?     @db.ObjectId
  design   tbl_Design? @relation(fields: [designId], references: [id])

  revisionId String?             @db.ObjectId
  revision   tbl_DesignRevision? @relation(fields: [revisionId], references: [id])

  // Boolean verdict and status
  isFeasible Boolean @default(true)
  // Values: PASSED | BLOCKED | WARNED
  status     String  @default("PASSED")

  // Production blockers: [{ ruleCode, type, field, message, currentValue, limit, suggestedFix }]
  violations     Json[]
  // Non-blocking manufacturing advisories
  warnings       Json[]
  // Actionable remediation steps for the shopper
  suggestedFixes Json[]

  // Snapshot of the full customer configuration tested (materials, dimensions, placement, options)
  validatedConfig Json

  // Performance telemetry
  executionTimeMs Float?
  checkedAt DateTime @default(now())

  @@index([shopifyProductId])
  @@index([shop, shopifyProductId])
}

// ============================================================
// 07 · PROOF  (Feature 2 — Formal proof sent to customer)
// ============================================================

model tbl_Proof {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  designId String     @db.ObjectId
  design   tbl_Design @relation(fields: [designId], references: [id])

  revisionId String             @db.ObjectId
  revision   tbl_DesignRevision @relation(fields: [revisionId], references: [id])

  proofNumber Int
  previewUrl  String

  // Values: PENDING | APPROVED | REVISION_REQUESTED | EXPIRED
  status String @default("PENDING")

  sentAt       DateTime?
  expiresAt    DateTime?
  customerNote String?
  merchantNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  approval tbl_ProofApproval?
  comments tbl_DesignComment[]
}

// ============================================================
// 08 · PROOF APPROVAL  (Feature 2 — Immutable approval audit record)
// ============================================================

model tbl_ProofApproval {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  proofId String    @unique @db.ObjectId
  proof   tbl_Proof @relation(fields: [proofId], references: [id])

  designId String @db.ObjectId

  revisionId String             @db.ObjectId
  revision   tbl_DesignRevision @relation(fields: [revisionId], references: [id])

  // Linked Shopify order for audit trail
  shopifyOrderId String?

  approvedBy     String
  // Values: CLICK_APPROVE | EMAIL_LINK | STAFF_OVERRIDE
  approvalMethod String

  // Legal audit fields
  ipAddress String?
  userAgent String?

  approvedAt DateTime @default(now())
}

// ============================================================
// 09 · DESIGN COMMENT  (Feature 7 — Threaded customer–merchant comments)
// ============================================================

model tbl_DesignComment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  designId String     @db.ObjectId
  design   tbl_Design @relation(fields: [designId], references: [id])

  proofId String?    @db.ObjectId
  proof   tbl_Proof? @relation(fields: [proofId], references: [id])

  revisionId String?             @db.ObjectId
  revision   tbl_DesignRevision? @relation(fields: [revisionId], references: [id])

  // Self-referential threading
  parentCommentId String? @db.ObjectId

  // Values: CUSTOMER | MERCHANT | SYSTEM
  authorType String
  authorId   String
  authorName String?

  body           String
  attachmentUrls String[]

  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 10 · ORDER TIMELINE  (Feature 6 — Per-order status container)
// ============================================================

model tbl_OrderTimeline {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop              String
  shopifyOrderId    String  @unique
  shopifyCustomerId String?

  designId String?     @unique @db.ObjectId
  design   tbl_Design? @relation(fields: [designId], references: [id])

  // Values: DESIGN_RECEIVED | PROOF_READY | PROOF_APPROVED | IN_PRODUCTION | QUALITY_CHECK | SHIPPED | DELIVERED | CANCELLED
  currentStage            String    @default("DESIGN_RECEIVED")
  estimatedCompletionDate DateTime?
  customerNotifyEmail     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events tbl_OrderTimelineEvent[]
}

// ============================================================
// 11 · ORDER TIMELINE EVENT  (Feature 6 — Individual stage-change events)
// ============================================================

model tbl_OrderTimelineEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  timelineId String            @db.ObjectId
  timeline   tbl_OrderTimeline @relation(fields: [timelineId], references: [id])

  // Values: DESIGN_RECEIVED | PROOF_READY | PROOF_APPROVED | IN_PRODUCTION | QUALITY_CHECK | SHIPPED | DELIVERED | CANCELLED
  stage       String
  title       String
  description String?

  // Values: SYSTEM | MERCHANT | WEBHOOK
  triggeredBy       String  @default("SYSTEM")
  isCustomerVisible Boolean @default(true)
  notificationSent  Boolean @default(false)

  occurredAt DateTime @default(now())

  // Extra context (e.g. tracking number, proof URL)
  metadata Json?
}

// ============================================================
// 10B · CUSTOM ORDER TIMELINE (Feature 6 — Order Progress Updates)
// ============================================================

enum OrderTimelineStage {
  DESIGN_RECEIVED
  PROOF_READY
  APPROVED
  IN_PRODUCTION
  SHIPPED
}

type TimelineHistoryEntry {
  stage     OrderTimelineStage
  message   String
  timestamp DateTime           @default(now())
  metadata  Json?
}

model CustomOrderTimeline {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  shopifyOrderId String                 @unique
  customerEmail  String
  currentStage   OrderTimelineStage     @default(DESIGN_RECEIVED)
  history        TimelineHistoryEntry[]
  metadata       Json?
  shop           String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([customerEmail])
  @@index([shopifyOrderId])
}

// ============================================================
// 12 · PRODUCTION FILE  (Feature 3 — Print-ready generated files)
// ============================================================

model tbl_ProductionFile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  designId String     @db.ObjectId
  design   tbl_Design @relation(fields: [designId], references: [id])

  revisionId String             @db.ObjectId
  revision   tbl_DesignRevision @relation(fields: [revisionId], references: [id])

  proofApprovalId String? @db.ObjectId

  fileUrl    String
  fileName   String
  // Values: PDF | PNG | SVG | AI | EPS | TIFF
  fileFormat String

  // Physical dimensions
  widthMm      Float
  heightMm     Float
  dpi          Int
  colorProfile String?
  bleedMm      Float?

  // Values: GENERATING | READY | FAILED
  status        String    @default("GENERATING")
  generatedAt   DateTime?
  fileSizeBytes Int?

  createdAt DateTime @default(now())

  // Relations
  handoffs tbl_ProductionHandoff[]
}

// ============================================================
// 13 · PRODUCTION RULE  (Feature 10 — Merchant routing rules)
// ============================================================

model tbl_ProductionRule {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop        String
  name        String
  description String?
  isActive    Boolean @default(true)

  // Lower number = higher priority
  priority Int @default(100)

  // [{ field, operator, value }] — e.g. { field: "material", operator: "eq", value: "leather" }
  conditions Json[]

  // Values: INTERNAL_QUEUE | SUPPLIER_API | EMAIL | WEBHOOK | TAG
  destination       String
  // Endpoint URL, queue name, email address, webhook config, etc.
  destinationConfig Json

  // Order tags applied to matching orders for downstream workflows
  orderTags String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  handoffs tbl_ProductionHandoff[]
}

// ============================================================
// 14 · PRODUCTION HANDOFF  (Feature 10 — Routing action audit log)
// ============================================================

model tbl_ProductionHandoff {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop           String
  shopifyOrderId String

  designId String?     @db.ObjectId
  design   tbl_Design? @relation(fields: [designId], references: [id])

  productionFileId String?             @db.ObjectId
  productionFile   tbl_ProductionFile? @relation(fields: [productionFileId], references: [id])

  ruleId String?             @db.ObjectId
  rule   tbl_ProductionRule? @relation(fields: [ruleId], references: [id])

  destination String
  // Values: PENDING | SENT | ACKNOWLEDGED | FAILED
  status      String @default("PENDING")

  sentAt         DateTime?
  acknowledgedAt DateTime?

  retryCount      Int     @default(0)
  lastError       String?
  responsePayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 15 · PRODUCT CUSTOMIZATION CONFIG  (Features 3, 4, 5 — Per-product specs)
// ============================================================

model tbl_ProductCustomizationConfig {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop             String
  shopifyProductId String
  // Null = applies to all variants; set to override for a specific variant
  shopifyVariantId String?

  // Named print zone (e.g., "front", "back", "sleeve", "default")
  printAreaName     String @default("default")

  // Physical print area dimensions (in millimeters)
  printAreaWidthMm  Float
  printAreaHeightMm Float

  // Target raster canvas dimensions (in pixels)
  printAreaWidthPx  Int
  printAreaHeightPx Int

  // Optional explicit minimum pixel constraints
  minWidthPx  Int?
  minHeightPx Int?

  // Resolution requirements in DPI (Feature 4: Artwork Quality Checker)
  minDpi         Int  @default(150)
  recommendedDpi Int  @default(300)
  maxDpi         Int? @default(1200)

  // Quality validation thresholds
  blurThreshold        Float @default(100.0) // Variance of Laplacian threshold (lower = blurrier)
  aspectRatioTolerance Float @default(0.05)  // 5% variance allowed before warning about aspect ratio mismatch
  maxFileSizeBytes     Int   @default(26214400) // 25 MB default limit

  // Accepted upload formats (Feature 4)
  allowedFormats    String[] @default(["image/png", "image/jpeg", "image/webp", "image/tiff"])
  allowedColorModes String[] @default(["rgb", "srgb", "cmyk"])

  // Production output spec (Feature 3)
  // Values: PDF | PNG | AI | EPS
  productionFormat   String @default("PDF")
  productionWidthMm  Float
  productionHeightMm Float
  bleedMm            Float? @default(3.0)

  // Feasibility rules (Feature 5): [{ ruleCode, description, condition }]
  feasibilityRules Json[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, shopifyProductId, shopifyVariantId, printAreaName])
}

// ============================================================
// 15B · PRODUCT MANUFACTURING CONSTRAINT (Feature 5 — Feasibility Rules)
// ============================================================

model tbl_ProductManufacturingConstraint {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop             String
  shopifyProductId String
  // Null = applies globally to product; non-null = variant-specific override
  shopifyVariantId String?

  // Physical printable dimensions limits (in millimeters)
  maxPrintWidthMm  Float
  maxPrintHeightMm Float
  minPrintWidthMm  Float   @default(10.0)
  minPrintHeightMm Float   @default(10.0)
  maxBleedMm       Float   @default(5.0)

  // Coordinate boundaries for design placement (in millimeters or coordinate units)
  // Format: { minX: Float, minY: Float, maxX: Float, maxY: Float }
  allowedPlacementBounds Json?

  // Whitelisted and blacklisted materials
  availableMaterials  String[] @default([])
  restrictedMaterials String[] @default([])

  // Incompatible option matrix:
  // e.g. [{ optionA: { name: "material", value: "leather" }, optionB: { name: "technique", value: "sublimation" }, reason: "...", suggestedFix: "..." }]
  incompatibleOptions Json[]

  // Material and color / finish restrictions:
  // e.g. [{ material: "black_cotton", disallowedColors: ["black", "dark_grey"], disallowedFinishes: ["gloss_foil"], reason: "...", suggestedFix: "..." }]
  restrictedMaterialColors Json[]

  // Supported manufacturing techniques (e.g., ["DTG", "EMBROIDERY", "SCREEN_PRINT", "UV_PRINT", "LASER_ENGRAVE"])
  allowedPrintMethods String[] @default(["DTG", "SCREEN_PRINT"])

  // Technique-specific physical constraints (e.g. Embroidery minTextHeightMm: 5.0, maxColors: 6)
  methodConstraints Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, shopifyProductId, shopifyVariantId])
  @@index([shopifyProductId])
  @@index([shop, shopifyProductId])
}

// ============================================================
// 16 · MERCHANT SETTINGS  (Global per-shop configuration)
// ============================================================

model tbl_MerchantSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shop String @unique

  // Feature 9 — Design Library
  designRetentionDays Int     @default(365)
  libraryEnabled      Boolean @default(true)

  // Feature 2 — Proof Approval
  proofApprovalRequired Boolean @default(true)
  proofExpiryHours      Int     @default(48)

  // Feature 1 — Save & Share
  shareLinksEnabled    Boolean @default(true)
  shareLinkExpiryHours Int?

  // Feature 4 — Artwork Checker
  artworkCheckerEnabled Boolean @default(true)

  // Feature 5 — Feasibility Checker
  feasibilityCheckerEnabled Boolean @default(true)

  // Feature 6 — Order Timeline Notifications
  timelineNotificationsEnabled Boolean @default(true)
  // Per-event email toggle map: { PROOF_READY: true, SHIPPED: true, ... }
  customerEmailNotifications   Json?

  // Feature 10 — Production Handoff
  productionHandoffEnabled Boolean @default(true)
  // Values: PDF | PNG | AI | EPS
  defaultProductionFormat  String  @default("PDF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
